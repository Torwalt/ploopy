{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan-unit": {
      "description": "Implements one unit of a task document, unattended.",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "git push*": "deny",
          "git reset --hard*": "deny",
          "git checkout master*": "deny",
          "git switch master*": "deny",
          "git checkout main*": "deny",
          "git switch main*": "deny",
          "git rebase*": "deny",
          "git clean*": "deny",
          "*": "allow"
        }
      }
    }
  }
}
